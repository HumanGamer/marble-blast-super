function initMS()
{
   if (isObject(MS_skinGroup))
      MS_skinGroup.delete();
   new SimGroup(MS_skinGroup);
   MarbleSelectGui.AddMarbles();
}

function MarbleSelectGui::onWake(%this)
{
   %this.buildSkinList();
}

function MarbleSelectGui::buildSkinList(%this)
{
   %this.SelectMarble($pref::MarbleIndex);
}

function MarbleSelectGui::SelectMarble(%this, %index)
{
   %skin = MS_skinGroup.getObject(%index).skin;
   MarbleSelectPreview.setModel("marble/data/shapes/balls/marble.dts", %skin);
   $pref::MarbleIndex = %index;
   MS_Prev.setActive(true);
   MS_Next.setActive(true);
   if (%index <= 0) MS_Prev.setActive(false);
   if (%index >= MS_skinGroup.getCount() - 1) MS_Next.setActive(false);
   MS_Prev.command = "MarbleSelectGui.SelectMarble("@%index-1@");";
   MS_Next.command = "MarbleSelectGui.SelectMarble("@%index+1@");";
}

function MarbleSelectGui::AddMarble(%this, %skin)
{
   MS_skinGroup.add(new SimObject(){skin=%skin;});
}

function MarbleSelectGui::GetMarble(%this, %index)
{
   return MS_skinGroup.getObject(%index).skin;
}

function MarbleSelectGui::AddMarbles(%this)
{
   %this.AddMarble("base");
   %this.AddMarble("blue");
   %this.AddMarble("red");
   %this.AddMarble("purple");
   %this.AddMarble("gold");
   %this.AddMarble("orange");
   %this.AddMarble("teal");
   %this.AddMarble("pink");
   %this.AddMarble("yellow");
   %this.AddMarble("blah");
   %this.AddMarble("blueabstract");
   %this.AddMarble("tealabstract");
   %this.AddMarble("yellowabstract");
   %this.AddMarble("greenabstract");
   %this.AddMarble("redabstract");
   %this.AddMarble("rscribble");
   %this.AddMarble("tscribble");
   %this.AddMarble("bscribble");
   %this.AddMarble("blackscribble");
   %this.AddMarble("yscribble");
   %this.AddMarble("oscribble");
   %this.AddMarble("gscribble");
   %this.AddMarble("pscribble");
   %this.AddMarble("marble01.normal");
}
