function EnterMultiplayerNameDlg::show(%this, %var, %command, %text)
{
   MultiplayerNameButton.command = %command;
   MultiplayerNameEdit.altCommand = %command;
   MultiplayerNameEdit.variable = %var;
   eval("%val = " @ %var @ ";");
   MultiplayerNameEdit.setText(%val);
   MultiplayerNameText.setText(%text);
   Canvas.pushDialog(EnterMultiplayerNameDlg);
}

function EnterMultiplayerNameDlg::hide(%this)
{
   Canvas.popDialog(EnterMultiplayerNameDlg);
   disconnect();
}
