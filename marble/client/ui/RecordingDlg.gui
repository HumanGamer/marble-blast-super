function RecordingDlg::show(%this, %var, %command, %text)
{
   RecordingNameButton.command = %command;
   RecordingNameEdit.altCommand = %command;
   RecordingNameEdit.variable = %var;
   eval("%val = " @ %var @ ";");
   RecordingNameEdit.setText(%val);
   RecordingNameText.setText(%text);
   Canvas.pushDialog(RecordingDlg);
}

function RecordingDlg::hide(%this)
{
   Canvas.popDialog(RecordingDlg);
}
