function MultiplayerExitGui::init(%this)
{
   MPE_Text.setText("<spush><font:Bauhaus 93:24>What would you like to do?<spop>");
   
   if ($Multiplayer::isHosting)
   {
      MPE_Lobby.setVisible(true);
      MPE_Restart.setVisible(true);
   } else {
      MPE_Lobby.setVisible(false);
      MPE_Restart.setVisible(false);
   }
}
