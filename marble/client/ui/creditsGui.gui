function CreditsGui::onWake(%this)
{
   CreditsGuiTitle.setText("Credits");
   %colorName = "<color:441111>";
   %colorUser = "<color:44CCCC>";
   %text = "<font:Whitestone:32><tab:230>";
   %text = %text @ %colorName @ "Stewart Inglis\t" @ %colorUser @ "StewMan46\n";
   %text = %text @ %colorName @ "Tristan Voss\t" @ %colorUser @ "Ender\n";
   %text = %text @ %colorName @ "David Luo\t" @ %colorUser @ "davidjl123\n";
   %text = %text @ %colorName @ "Matthieu Parizeau\t" @ %colorUser @ "cooldudepoke\n";
   %text = %text @ %colorName @ "Erik Martin\t" @ %colorUser @ "Neon Lightning\n";
   %text = %text @ %colorName @ "Greg McFadden\t" @ %colorUser @ "Skail\n";
   %text = %text @ %colorName @ "James Colsey\t" @ %colorUser @ "BlastedMarble\n";
   %text = %text @ %colorName @ "Chris Schroeppel\t" @ %colorUser @ "Rozi\n";
   
   CreditsGuiText.setText(%text);
}
