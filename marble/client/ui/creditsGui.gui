function CreditsGui::onWake(%this)
{
   %this.bitmap = getRandomBackground();
   //CreditsGuiTitle.setText("Credits");
   //%colorName = "<color:441111>";
   //%colorUser = "<color:44CCCC>";
   //%text = "<font:EntangledMBS:32><tab:230>";
   //%text = %text @ %colorName @ "Stewart Inglis\t" @ %colorUser @ "StewMan46\n";
   //%text = %text @ %colorName @ "Tristan Voss\t" @ %colorUser @ "Ender\n";
   //%text = %text @ %colorName @ "David Luo\t" @ %colorUser @ "davidjl123\n";
   //%text = %text @ %colorName @ "Matthieu Parizeau\t" @ %colorUser @ "cooldudepoke\n";
   //%text = %text @ %colorName @ "Erik Martin\t" @ %colorUser @ "Neon Lightning\n";
   //%text = %text @ %colorName @ "Greg McFadden\t" @ %colorUser @ "Skail\n";
   //%text = %text @ %colorName @ "James Colsey\t" @ %colorUser @ "BlastedMarble\n";
   //%text = %text @ %colorName @ "Chris Schroeppel\t" @ %colorUser @ "Rozi\n";
   
   CreditsGuiText.setText(%text);
   
   CR_List.clear();
   CR_List.addRow(0, "Matthieu Parizeau");
   CR_List.addRow(1, "Chris Schroeppel");
   CR_List.addRow(2, "David Luo");
   CR_List.addRow(3, "Tristan Voss");
   CR_List.addRow(4, "Greg McFadden");
   CR_List.addRow(5, "James Colsey");
   CR_List.addRow(6, "Erik Martin");
   CR_List.addRow(7, "Stewart Inglis");
   
   CR_List.setSelectedByID(0);
}

function CR_List::onSelect(%this, %index)
{
   CreditsGui.setPage(%index + 1);
}

function CreditsGui::setPage(%this, %page)
{
   switch(%page)
   {
      case 1: // Matthieu Parizeau (cooldudepoke)
         %text = "<font:EntangledMBS:18>[Also known as cooldudepoke]\n\n<font:EntangledMBS:24>Matthieu is the new leader who replaced Stewart Inglis. \n\n" @
                 "He's done the biggest part of Marble Blast Super, which includes coding, level building, and creating textures.\n\n" @
                 "Definitely the core of Marble Blast Super. The mod could not be done without him.";
      break;
      case 2: // Chris Schroeppel (Rozi)
         %text = "<font:EntangledMBS:18>[Also known as Rozi]\n\n<font:EntangledMBS:24>Chris was mainly a level builder, but every now and then he would go in and change a couple scripts, like the manual, and the credits. Most of his time when he first joined was making the tutorial levels." @
				 "Chris one time tried out a bit of coding learned from Whirligig231, and successfully coded the achievements: \"Getting Started\", \"5 Down\", and \"10 levels\", and afterwards, stopping there.";
		 break;
      case 3: // David Luo (davidjl123)
         %text = "<font:EntangledMBS:18>[Also known as davidjl123]\n\n<font:EntangledMBS:24>David does a lot of level building a testing. He first came up of the core idea of Marble Blast Super - nature.";
      break;
      case 4: // Tristan Voss (Ender)
         %text = "<font:EntangledMBS:18>[Also known as Ender]\n\n<font:EntangledMBS:24>A level builder, and graphics artist.\n\n" @
                 "Tristan was here from the beginning. If it wasn't for him, this mod wouldn't have continued.";
      break;
      case 5: // Greg McFadden (Skail)
         %text = "<font:EntangledMBS:18>[Also known as Skail]\n\n<font:EntangledMBS:24>Greg made every piece of music found in Marble Blast Super. The mod would be really quiet without him!";
      break;
      case 6: // James Colsey (BlastedMarble)
         %text = "<font:EntangledMBS:18>[Also known as BlastedMarble]\n\n<font:EntangledMBS:24>James took part in almost every Advanced and Expert level, and he has done a good job with them." @
				 "Up to June, James has taken a long break from Marble Blast Super because of problems with Constructor, and a broken computer. Hopefully we will have him back soon!";
      break;
      case 7: // Erik Martin (Neon Lightning)
         %text = "<font:EntangledMBS:18>[Also known as Neon Lightning]\n\n<font:EntangledMBS:24>Various small changes, such as the " @
                 "green editor. He has made at least one level for the game, but he is mainly a tester.";
      break;
      case 8: // Stewart Inglis (StewMan46)
         %text = "<font:EntangledMBS:18>[Also known as StewMan46]\n\n<font:EntangledMBS:24>Stewart was the first leader of the mod. " @
                 "If it wasn't for him, Marble Blast Super would not exist. Huge thanks to him for starting this amazing mod!";
      break;
   }
   CreditsGuiTitle.setText(CR_List.getRowTextById(CR_List.getSelectedId()));
   CreditsGuiText.setText(%text);
}
