$ConsoleActive = false;

function ConsoleEntry::eval()
{
   %text = ConsoleEntry.getValue();
   user("==>" @ %text);
	%return = eval(%text);
	if (%return !$= "")
		echo("(Returned value \"" @ %return @ "\")");
   ConsoleEntry.setValue("");
}

function ToggleConsole(%make)
{
   if (%make)
   {
      if (ConsoleDlg.isAwake())
      //if ($ConsoleActive)
      {
         //if ( $enableDirectInput )
         //   activateKeyboard();
         Canvas.popDialog(ConsoleDlg);
         $ConsoleActive = false;
      }
      else
      {
         //if ( $enableDirectInput )
         //   deactivateKeyboard();
         Canvas.pushDialog(ConsoleDlg, 99);
         $ConsoleActive = true;
      }
   }
}

package ConsoleOverride {
   
   //function echo(%message)
   //{
      //Parent::echo(%message);
   //}
   //
   //function warn(%message)
   //{
      //echo("\c6" @ %message);
   //}
   //
   //function error(%message)
   //{
      //echo("\c7" @ %message);
   //}
   
   // This function is to go along with echo, warn, and error
   function user(%message)
   {
      echo("\c3" @ %message);
   }

   function debug(%message)
   {
      if ($showDebug)
         echo("\c4" @ %message);
   }

   function info(%message)
   {
      if ($showInfo)
         echo("\c5" @ %message);
   }

};

activatePackage(ConsoleOverride);

function doTrace()
{
	trace($trace);
}
